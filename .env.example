# Salin ke .env hanya jika belum ada. Jangan commit nilai rahasia.

# --- Provider aktif: 9Router lokal (Windows, bukan Docker) ---
CABAI_KMS_TEXT_PROVIDER=9router
CABAI_KMS_VISION_PROVIDER=9router

NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_TEXT_MODEL=ag/gemini-3.8-flash-medium
NINEROUTER_VISION_MODEL=ag/gemini-3.8-flash-high
NINEROUTER_TIMEOUT_SECONDS=60

# Jangan commit .env atau API key. 9Router mengelola routing/kuota ketiga
# akun Antigravity; aplikasi tidak memilih atau merotasi akun.

# --- Explicit legacy rollback only: Groq -> Ollama text, Gemini vision ---
# Set both CABAI_KMS_*_PROVIDER values to legacy to activate these variables.
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Vision: Gemini utama; diperlukan bila memproses foto ---
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest

# Opsional hanya dalam legacy mode. Consensus selalu nonaktif dalam 9Router mode.
OPENROUTER_API_KEY=

# --- Optional per-process provider-attempt rate limits ---
# Blank disables that provider's limiter. Values must be positive numbers.
CABAI_KMS_TEXT_RPM=
CABAI_KMS_VISION_RPM=

# --- Google Drive crawler: hanya JSON service account ---
GOOGLE_DRIVE_CREDENTIALS_PATH=
# Default untuk pemanggilan crawler langsung. UI perlu URL/ID pada form.
GOOGLE_DRIVE_FOLDER_ID=

# Lokasi Chroma default: data/.chroma/, ditentukan dalam indexing.py.
# CHROMA_PERSIST_DIR tidak dibaca implementasi saat ini.
