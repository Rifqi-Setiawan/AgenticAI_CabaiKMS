# Salin ke .env hanya jika belum ada. Jangan commit nilai rahasia.

# --- Schema matching: Groq utama, Ollama fallback ---
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Vision: Gemini utama; diperlukan bila memproses foto ---
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest

# Opsional: voter kedua untuk consensus melalui API Python, bukan UI.
OPENROUTER_API_KEY=

# --- Google Drive crawler: hanya JSON service account ---
GOOGLE_DRIVE_CREDENTIALS_PATH=
# Default untuk pemanggilan crawler langsung. UI perlu URL/ID pada form.
GOOGLE_DRIVE_FOLDER_ID=

# Lokasi Chroma default: data/.chroma/, ditentukan dalam indexing.py.
# CHROMA_PERSIST_DIR tidak dibaca implementasi saat ini.
