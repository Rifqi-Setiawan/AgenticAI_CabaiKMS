# Merge required values into your existing environment; never replace model/gateway settings.
# bootstrap_postgres.py generates real private credentials for local PostgreSQL.
KMS_ENABLED=false
DATABASE_URL=postgresql+psycopg://cabai_app:replace_from_private_bootstrap@127.0.0.1:5432/cabai_kms
DB_AUTO_MIGRATE=false
ALLOW_LEGACY_SOURCELESS_RUNS=false
DB_POOL_SIZE=4
KMS_API_BASE_URL=http://127.0.0.1:8091
KMS_API_TOKEN=
# Runtime API requires token->principal mappings with >=32-character secrets.
KMS_TOKENS_JSON={}
KMS_SOURCE_SCOPE=cabai-research
KMS_PROVIDER_MANIFEST_JSON={}
# Production recommendation: private R2/S3; local mode is for development/transition.
MEDIA_BACKEND=local
MEDIA_STORAGE_PATH=/srv/media/cabai-kms
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8091
MEDIA_MAX_BYTES=26214400
MEDIA_MAX_PIXELS=40000000
MEDIA_MIN_FREE_BYTES=5368709120
SOURCE_MAX_BYTES=52428800
API_MAX_BODY_BYTES=67108864
# Enable MEDIA_BACKEND=s3 only after setting and verifying all required values.
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=cabai-kms-private
S3_REGION=auto
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY belong in /etc/cabai-kms/runtime.env.
# GOOGLE_DRIVE_CREDENTIALS_PATH belongs in the same private API environment.
# OUTBOX_WEBHOOK_URL and OUTBOX_WEBHOOK_SECRET are optional; no destination is assumed.
