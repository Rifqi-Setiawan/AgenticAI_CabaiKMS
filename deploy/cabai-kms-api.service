[Unit]
Description=CABAI-KMS persistence API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cabai
Group=cabai
WorkingDirectory=/srv/cabai-kms
EnvironmentFile=/etc/cabai-kms/runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/cabai-kms/.venv-kms/bin/uvicorn src.kms_api.app:create_app --factory --host 127.0.0.1 --port 8091 --workers 1 --limit-concurrency 8 --timeout-keep-alive 5 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/media/cabai-kms
MemoryMax=4G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
